generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String        @id @default(cuid())
  name               String?
  email              String?       @unique
  emailVerified      DateTime?
  image              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  accounts           Account[]
  addedUsers         AllowedUser[] @relation("AddedBy")
  revokedCredentials Credential[]  @relation("RevokedBy")
  issuer             Issuer?
  sessions           Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AllowedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  addedById String?
  createdAt DateTime @default(now())
  addedBy   User?    @relation("AddedBy", fields: [addedById], references: [id])
}

model Issuer {
  id                        String       @id @default(cuid())
  userId                    String       @unique
  issuerDid                 String
  issuerName                String
  consumptionSchemaId       String?
  consumptionTemplateId     String?
  utilityCustomerSchemaId   String?
  utilityCustomerTemplateId String?
  generationSchemaId        String?
  generationTemplateId      String?
  storageSchemaId           String?
  storageTemplateId         String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  credentials               Credential[]
  user                      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Credential {
  id             String           @id @default(cuid())
  issuerId       String
  credentialId   String
  credentialType CredentialType
  subjectId      String?
  subjectName    String?
  subjectData    Json
  status         CredentialStatus @default(ISSUED)
  issuedAt       DateTime         @default(now())
  revokedAt      DateTime?
  revokedById    String?
  issuer         Issuer           @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  revokedBy      User?            @relation("RevokedBy", fields: [revokedById], references: [id])

  @@index([issuerId])
  @@index([status])
  @@index([credentialType])
}

enum CredentialType {
  CONSUMPTION
  UTILITY_CUSTOMER
  GENERATION
  STORAGE
}

enum CredentialStatus {
  ISSUED
  REVOKED
}
